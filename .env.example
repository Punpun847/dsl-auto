DATABASE_URL=postgresql+asyncpg://gyso:gyso1234@localhost:5432/gyso_db
REDIS_URL=redis://localhost:6379/0

# ⚠️ ตั้งเป็น random string ยาว ≥32 chars — ใช้ encrypt NID/PWD + JWT signing
SECRET_KEY=change-this-to-a-random-secret-key

UPLOAD_DIR=./uploads

# Admin panel — ห้าม leave default ใน production
ADMIN_PASSWORD=admin1234

# CORS — comma-separated origins, ใช้ "*" เฉพาะ dev เท่านั้น
# Example: CORS_ORIGINS=https://example.com,https://api.example.com
CORS_ORIGINS=*

# Production mode — true จะ raise error ถ้า secret/admin_password ยังเป็น default
IS_PRODUCTION=false

# FREE_MODE — ปิดระบบชำระเงิน ให้ user ใช้ฟรี (สำหรับ beta/launch ช่วงแรก)
# true  = ไม่ต้องแนบสลิป, payment auto-verified, frontend ซ่อน step ชำระเงิน
# false = ใช้ flow ปกติ (ต้องแนบสลิป + SlipOK/OCR verify)
FREE_MODE=true

# Payment account (เลขโทร 10 / NID 13 / eWallet 15 หลัก)
EXPECTED_ACCOUNT=0991234564
EXPECTED_RECIPIENT_NAME=
EXPECTED_BANK_KEYWORDS=กสิกร,ไทยพาณิชย์,กรุงเทพ,กรุงไทย,กรุงศรี,ออมสิน,ttb,scb,kbank,kkp,bbl,ktb,bay,gsb
SLIP_MAX_AGE_MINUTES=30

# JWT
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_HOURS=24

# Optional external APIs
SLIPOK_API_KEY=
SLIPOK_BRANCH_ID=
GEMINI_API_KEY=
